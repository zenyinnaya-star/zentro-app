# Copy this file to .env and fill in your Supabase project values.
# Find these in your Supabase project: Settings > API
# The EXPO_PUBLIC_ prefix is required for Expo to expose these to client code.
Pls do not write the Api keys here this a place holder for you to know how it looks


EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Required for the Map screen (react-native-maps) to render on Android/iOS.
# Get one from https://console.cloud.google.com/google/maps-apis (enable
# "Maps SDK for Android" and "Maps SDK for iOS"). Read by app.config.js —
# no EXPO_PUBLIC_ prefix, it's only used at build/config time, not in client JS.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
